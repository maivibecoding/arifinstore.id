# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://www.arifinstore.web.id

# Sekalipay API Credentials (Layanan Top-Up E-Money & Validasi Akun)
# Dapatkan API Key di: Dashboard Sekalipay -> Menu Settings/API
SEKALIPAY_API_KEY=YOUR_SEKALIPAY_API_KEY_HERE
SEKALIPAY_BASE_URL=https://sekalipay.com

# IndoApi Payment Gateway (QRIS Otomatis)
INDOAPI_API_KEY=YOUR_INDOAPI_API_KEY_HERE
INDOAPI_BASE_URL=https://indoapi.biz

# ProdSeller API (Produk Digital / Akun Premium)
PRODSELLER_API_KEY=YOUR_PRODSELLER_API_KEY_HERE
PRODSELLER_BASE_URL=https://prodseller.com/v1
